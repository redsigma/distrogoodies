case ":${PATH:-}:" in
    *":${HOME}/.local/bin:"*) ;;
    *)
        if [ -x /usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator ]; then
            set -a
            eval "$(/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator 2>/dev/null)"
            set +a
        fi
        ;;
esac
